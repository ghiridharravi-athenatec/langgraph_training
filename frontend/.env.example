# Copy to .env.local for local overrides. Not needed for `npm run dev` or the
# docker-compose frontend - both already reach the API at a relative /api/v1
# via a proxy. Set this only for a split deployment (e.g. Vercel) where the
# frontend and API are on different origins - in Vercel's project settings,
# add it as an Environment Variable so it's baked in at build time.
VITE_API_BASE_URL=https://your-space-name.hf.space/api/v1

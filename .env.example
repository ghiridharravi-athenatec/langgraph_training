# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
MONGO_URI=your_mongodb_connection_string_here

# --- Auth / RBAC ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=hWJd2-rV6fFMrh41FdxUsvOvl8uvVvVPmH2wG-WvWNsg6z-A4a9Uk2yjhKCrlsdk
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin account, created on startup if it doesn't already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zKBwfbnvliRo4B9M

# React dev server origin (Vite), used for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: origin of the frontend that's allowed to call the API ---
# In docker-compose this is the frontend container's published port. For a
# split deployment (frontend on Vercel, backend on its own host/Space), set
# this to the deployed frontend's origin, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# --- Refresh cookie ---
# Defaults (Lax, non-Secure) are correct for same-origin local/docker-compose
# dev over HTTP. A split deployment is cross-site from the browser's point of
# view and needs both flipped, or the refresh cookie never comes back:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Ingestion guardrails ---
MAX_UPLOAD_SIZE_MB=25

# --- Retrieval / generation guardrails ---
MAX_CONTEXT_CHARS=16000
MIN_GROUNDEDNESS_SCORE=0.3
ALLOWED_URL_DOMAINS=
REQUEST_TIMEOUT_SECONDS=30

# --- Operational guardrails ---
DAILY_TOKEN_QUOTA=50000
CHAT_RATE_LIMIT=20
INGEST_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth guardrails ---
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# --- Chat history / semantic cache ---
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.93
SEMANTIC_CACHE_MAX_CANDIDATES=200

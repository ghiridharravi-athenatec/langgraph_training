# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
MONGO_URI=your_mongodb_connection_string_here

# --- LLM provider (Claude primary, Gemini fallback) ---
# Every text-generation call tries Claude first, falls back to Gemini (using
# GEMINI_API_KEY above) on any failure - see app/core/llm_provider.py.
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Database Ingestion ("chat with your database") ---
# Fernet key encrypting saved external DB connection credentials at rest -
# generate one the same way as PII_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Deliberately a separate key from PII_ENCRYPTION_KEY (guardrails.py) so the two
# can be rotated independently. Unset - like that one - falls back to an
# ephemeral per-process key with a startup warning; saved connections become
# unrecoverable after a restart until this is set.
DB_CREDENTIAL_ENCRYPTION_KEY=
DB_AGENT_MAX_TOOL_CALLS=6
DB_QUERY_ROW_LIMIT=200
DB_QUERY_TIMEOUT_SECONDS=15

# --- Auth / RBAC ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=hWJd2-rV6fFMrh41FdxUsvOvl8uvVvVPmH2wG-WvWNsg6z-A4a9Uk2yjhKCrlsdk
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin account, created on startup if it doesn't already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zKBwfbnvliRo4B9M

# React dev server origin (Vite), used for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: origin of the frontend that's allowed to call the API ---
# In docker-compose this is the frontend container's published port. For a
# split deployment (frontend on Vercel, backend on its own host/Space), set
# this to the deployed frontend's origin, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# --- Refresh cookie ---
# Defaults (Lax, non-Secure) are correct for same-origin local/docker-compose
# dev over HTTP. A split deployment is cross-site from the browser's point of
# view and needs both flipped, or the refresh cookie never comes back:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Ingestion guardrails ---
MAX_UPLOAD_SIZE_MB=25

# --- Retrieval / generation guardrails ---
MAX_CONTEXT_CHARS=8000
MIN_GROUNDEDNESS_SCORE=0.35
ALLOWED_URL_DOMAINS=
REQUEST_TIMEOUT_SECONDS=30

# --- Operational guardrails ---
DAILY_TOKEN_QUOTA=50000
CHAT_RATE_LIMIT=20
INGEST_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth guardrails ---
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_MINUTES=60

# --- Email (SMTP) - only used to send password reset links. Leave blank to
# disable email sending (forgot-password still "succeeds" from the caller's
# point of view - see app/core/email.py - it just won't deliver anything).
# Example for Gmail: host smtp.gmail.com, port 587, username your address,
# password an App Password (not your normal Gmail password - generate one at
# https://myaccount.google.com/apppasswords, requires 2FA enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Chat history / semantic cache ---
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
SEMANTIC_CACHE_MAX_CANDIDATES=200
